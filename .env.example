# ---------------------------------------------------------------------------
# Hosting (leave every value below blank to keep the local, single-user setup)
# ---------------------------------------------------------------------------
# Supabase project settings -> API. The service key bypasses row level security:
# keep it server-side only, never in a browser, a workspace, or a commit.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Private Storage bucket holding the workspace versions (created by the migration).
SUPABASE_BUCKET=workbooks
UH_WORKSPACE_NAME=UH_Homes_Selections_Tracker.xlsx

# Bind address. Anything other than 127.0.0.1 is reachable by others, so the app
# then refuses to start unless sign-in, a secret key and trusted hosts are all set.
UH_HOST=127.0.0.1
# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
UH_SECRET_KEY=
# Comma-separated hostnames this deployment answers on, e.g. uh-selections.onrender.com
# deploy_render.py sets this on the host automatically from the hostname Render assigns.
UH_TRUSTED_HOSTS=

# Only needed to run deploy_render.py (Render dashboard -> Account Settings -> API Keys).
# It is never sent to the deployed app, only used to create and configure it.
RENDER_API_KEY=
